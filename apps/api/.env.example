# AWS Configuration
AWS_REGION=us-east-1

# DynamoDB
DYNAMODB_ITEMS_TABLE=MyDriverItems
DYNAMODB_SHARES_TABLE=MyDriverShares
# DYNAMODB_ENDPOINT=http://localhost:8000  # For local DynamoDB

# S3
S3_BUCKET=my-driver-files
S3_PRESIGNED_URL_EXPIRY=3600
# S3_ENDPOINT=http://localhost:9000  # For local MinIO/LocalStack

# CORS
ALLOWED_ORIGINS=http://localhost:4200

# Server
PORT=3000
